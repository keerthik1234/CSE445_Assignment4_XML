<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://venus.sod.asu.edu/WSRepository/xml" targetNamespace="http://venus.sod.asu.edu/WSRepository/xml" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xsd:annotation>
    <xsd:documentation xml:lang="en"> National Parks Data </xsd:documentation>
  </xsd:annotation>
  <xsd:element name="NationalParks" type="ParksType"/>
  <xsd:complexType name="ParksType">
    <xsd:sequence>
      <xsd:element name="NationalPark" type="ParkDetails" minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="Rating" type="RatingType" use="optional"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ParkDetails">
    <xsd:sequence>
      <xsd:element name="Name" type="xsd:string" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Phone" type="PhoneType" minOccurs="1" maxOccurs="unbounded" />
      <xsd:element name="Address" type="AddressType" minOccurs="1" maxOccurs="1"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:simpleType name="ParksType">
    <xsd:sequence>
      <xsd:element name="NationalPark" type="EmptyType" minOccurs="0" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:simpleType>
  <!--  Define the allowed format for the Phone number with a regular exp.  -->
  <xsd:simpleType name="PhoneType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="\d{3}\-\d{3} \d{4}"/>
    </xsd:restriction>
  </xsd:simpleType>
  <!--  Define the allowed format for an empty element with a string length of 0.  -->
  <xs:simpleType name="EmptyType">
    <xs:restriction base="xs:string">
      <xs:length value="0"/>
    </xs:restriction>
  </xs:simpleType>
  <!--  Define the allowed format for an up to one decimal rating out of 5.  -->
  <xs:simpleType name="RatingType">
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="1"/>
      <xs:maxInclusive value="5"/>
    </xs:restriction>
  </xs:simpleType>
  <!--  Define the allowed format for an address.  -->
  <xs:complexType name="AddressType">
    <xsd:sequence>
      <xsd:element name="Number" type="xsd:integer" minOccurs="1" maxOccurs="1"/>
      <xs:element name="Street" type="xsd:string" minOccurs="1" maxOccurs="1" />
      <xsd:element name="City" type="xsd:string" minOccurs="1" maxOccurs="1"/>
      <xsd:element name="State" type="StateType" minOccurs="1" maxOccurs="1"/>
      <xsd:element name="Zip" type="ZipcodeType" minOccurs="1" maxOccurs="1"/>
      <xsd:attribute name="NearestAirport" type="xsd:string" use="required"/>
    </xsd:sequence>
  </xs:complexType>  
  <!--  Define the allowed format for a state name in the address format type.  -->
  <!--  Define the allowed format for a five-digit zipcode in the address format type.  -->
</xsd:schema>
